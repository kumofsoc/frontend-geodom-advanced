# Leave VITE_API_URL unset for a local interactive demo. Set it to the FastAPI origin for live mode.
VITE_API_URL=http://localhost:8000

# JavaScript API key for Yandex Maps. The map loader also works without this variable
# only where Yandex allows keyless development access; for stable demo/production set a key.
VITE_YANDEX_MAPS_API_KEY=
